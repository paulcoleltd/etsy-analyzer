{
  "name": "etsy-analyzer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "db:push": "pnpm --filter @etsy-analyzer/db push",
    "db:migrate": "pnpm --filter @etsy-analyzer/db migrate",
    "db:generate": "pnpm --filter @etsy-analyzer/db generate"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.4.5",
    "prettier": "^3.3.3",
    "@types/node": "^20.14.0"
  }
}
