# ── DATABASE ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/etsy_analyzer
DATABASE_URL_TIMESCALE=postgresql://postgres:password@localhost:5432/etsy_analyzer
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# ── AUTH ──────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_min_64_chars_here_replace_in_production
JWT_REFRESH_SECRET=your_refresh_secret_min_64_chars_here_replace_in_production
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# ── ETSY API ──────────────────────────────────────────────────────
ETSY_API_KEY=your_etsy_api_key
ETSY_API_SECRET=your_etsy_api_secret
ETSY_REDIRECT_URI=http://localhost:3000/auth/etsy/callback

# ── AI ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── PAYMENTS ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_AGENCY_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_AGENCY_ANNUAL=price_...

# ── EMAIL ─────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
FROM_EMAIL=alerts@yourdomain.com

# ── SCRAPING ──────────────────────────────────────────────────────
BRIGHTDATA_USERNAME=your_proxy_user
BRIGHTDATA_PASSWORD=your_proxy_password
BRIGHTDATA_HOST=brd.superproxy.io
BRIGHTDATA_PORT=22225

# ── AWS ───────────────────────────────────────────────────────────
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET=etsy-analyzer-assets
AWS_KMS_KEY_ARN=arn:aws:kms:...

# ── ENCRYPTION ────────────────────────────────────────────────────
TOKEN_ENCRYPTION_KEY=your_32_byte_hex_key_for_aes256_replace_in_production

# ── ANALYTICS ─────────────────────────────────────────────────────
POSTHOG_KEY=phc_...
POSTHOG_HOST=https://eu.posthog.com

# ── INTERNAL SERVICE URLS (Docker / K8s) ──────────────────────────
AUTH_SERVICE_URL=http://auth-service:3001
ANALYTICS_SERVICE_URL=http://analytics-service:8001
RESEARCH_SERVICE_URL=http://research-service:8002
KEYWORD_SERVICE_URL=http://keyword-service:8003
COMPETITOR_SERVICE_URL=http://competitor-service:3002
GRADER_SERVICE_URL=http://grader-service:8004
NOTIFICATION_SERVICE_URL=http://notification-service:3003

# ── FEATURE FLAGS ─────────────────────────────────────────────────
ENABLE_SCRAPING=true
ENABLE_AI_GRADER=true
ENABLE_CHROME_EXTENSION_API=true
