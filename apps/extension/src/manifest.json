{
  "manifest_version": 3,
  "name": "Etsy Analyzer",
  "version": "0.1.0",
  "description": "Revenue estimates and market intelligence for Etsy sellers",
  "permissions": ["storage", "alarms", "identity"],
  "host_permissions": [
    "https://*.etsy.com/*",
    "http://localhost:3001/*",
    "http://localhost:8002/*",
    "http://localhost:8004/*"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.etsy.com/*"],
      "js": ["src/content/index.ts"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/content/*"],
      "matches":   ["https://www.etsy.com/*"]
    }
  ]
}
